al-modal-overlay hidden","aria-labelledby":"terms-modal-title","role":"dialog","aria-modal":"true"},"\n    ",["DIV",{"class":"legal-modal-sheet"},"\n      ",["HEADER",{"class":"legal-modal-header"},"\n        ",["H3",{"id":"terms-modal-title"},"Términos y Condiciones"],"\n        ",["BUTTON",{"class":"legal-modal-close","onclick":"","aria-label":"Cerrar"},"\n          ",["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","data-lucide":"x","aria-hidden":"true","class":"lucide lucide-x"},["path",{"d":"M18 6 6 18"}],["path",{"d":"m6 6 12 12"}]],"\n        "],"\n      "],"\n      ",["DIV",{"class":"legal-modal-body"},"\n        ",["SECTION",{"class":"legal-section"},"\n          ",["H4",{},"1. Aceptación de los Términos"],"\n          ",["P",{},"Al acceder y utilizar la plataforma \"Entrena tu ser\", aceptas cumplir y estar sujeto a estos Términos y Condiciones. Si no estás de acuerdo con alguna parte de estos términos, no debes utilizar nuestro servicio."],"\n        "],"\n        ",["SECTION",{"class":"legal-section"},"\n          ",["H4",{},"2. Descripción del Servicio"],"\n          ",["P",{},"\"Entrena tu ser\" es una plataforma web de fitness que proporciona rutinas de ejercicio, seguimiento de progreso, videos demostrativos, chatbot de entrenamiento y herramientas de gamificación para motivar a los usuarios en su camino hacia una vida más saludable."],"\n        "],"\n        ",["SECTION",{"class":"legal-section"},"\n          ",["H4",{},"3. Registro y Cuenta de Usuario"],"\n          ",["UL",{},"\n            ",["LI",{},"Debes tener al menos 13 años para crear una cuenta."],"\n            ",["LI",{},"Eres responsable de mantener la confidencialidad de tu contraseña."],"\n            ",["LI",{},"Debes proporcionar información veraz y actualizada durante el registro."],"\n            ",["LI",{},"Eres responsable de todas las actividades que ocurran bajo tu cuenta."],"\n          "],"\n        "],"\n        ",["SECTION",{"class":"legal-section"},"\n          ",["H4",{},"4. Uso Aceptable"],"\n          ",["P",{},"Te comprometes a no utilizar el servicio para:"],"\n          ",["UL",{},"\n            ",["LI",{},"Actividades ilegales o no autorizadas."],"\n            ",["LI",{},"Transmitir virus, malware o código dañino."],"\n            ",["LI",{},"Suplantar a otra persona o entidad."],"\n            ",["LI",{},"Interferir con la seguridad o integridad del servicio."],"\n          "],"\n        "],"\n        ",["SECTION",{"class":"legal-section"},"\n          ",["H4",{},"5. Propiedad Intelectual"],"\n          ",["P",{},"Todo el contenido de la plataforma (textos, gráficos, logos, videos, código) es propiedad de \"Entrena tu ser\" o sus licenciantes y está protegido por leyes de propiedad intelectual. No puedes reproducir, distribuir o crear obras derivadas sin permiso expreso."],"\n        "],"\n        ",["SECTION",{"class":"legal-section"},"\n          ",["H4",{},"6. Limitación de Responsabilidad"],"\n          ",["P",{},"La información proporcionada en esta plataforma es solo para fines educativos e informativos. No constituye asesoramiento médico profesional. Consulta a un profesional de la salud antes de iniciar cualquier programa de ejercicio. \"Entrena tu ser\" no se hace responsable de lesiones o daños derivados del uso de la plataforma."],"\n        "],"\n        ",["SECTION",{"class":"legal-section"},"\n          ",["H4",{},"7. Modificaciones del Servicio"],"\n          ",["P",{},"Nos reservamos el derecho de modificar, suspender o discontinuar el servicio (o cualquier parte de él) en cualquier momento, con o sin previo aviso."],"\n        "],"\n        ",["SECTION",{"class":"legal-section"},"\n          ",["H4",{},"8. Terminación"],"\n          ",["P",{},"Podemos terminar o suspender tu acceso al servicio inmediatamente, sin previo aviso, por conducta que consideremos que viola estos Términos."],"\n        "],"\n        ",["SECTION",{"class":"legal-section"},"\n          ",["H4",{},"9. Ley Aplicable"],"\n                  ",["P",{},"Estos Términos se regirán e interpretarán de acuerdo con las leyes de los Estados Unidos Mexicanos y del Estado de Nuevo León, sin tener en cuenta sus disposiciones sobre conflicto de leyes."],"\n        "],"\n        ",["SECTION",{"class":"legal-section"},"\n                  ",["H4",{},"10. Responsable"],"\n                  ",["P",{},"El responsable de la plataforma es la ",["STRONG",{},"Universidad Tecnológica de Santa Catarina"]," (UTSC), con domicilio en Carretera Saltillo-Monterrey Km. 61.5, C.P. 66359, Santa Catarina, N.L., México."],"\n                "],"\n                ",["SECTION",{"class":"legal-section"},"\n                  ",["H4",{},"11. Contacto"],"\n          ",["P",{},"Si tienes preguntas sobre estos Términos, contáctanos en: ",["A",{"href":"mailto:legal@utsc.edu.mx"},"legal@utsc.edu.mx"]],"\n        "],"\n                ",["P",{"class":"legal-last-updated"},"Última actualización: 17 de noviembre de 2026"],"\n      "],"\n    "],"\n  "],"\n\n  ",["DIV",{"id":"privacy-modal","class":"legal-modal-overlay hidden","aria-labelledby":"privacy-modal-title","role":"dialog","aria-modal":"true"},"\n    ",["DIV",{"class":"legal-modal-sheet"},"\n      ",["HEADER",{"class":"legal-modal-header"},"\n        ",["H3",{"id":"privacy-modal-title"},"Política de Privacidad"],"\n        ",["BUTTON",{"class":"legal-modal-close","onclick":"","aria-label":"Cerrar"},"\n          ",["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","data-lucide":"x","aria-hidden":"true","class":"lucide lucide-x"},["path",{"d":"M18 6 6 18"}],["path",{"d":"m6 6 12 12"}]],"\n        "],"\n      "],"\n      ",["DIV",{"class":"legal-modal-body"},"\n        ",["SECTION",{"class":"legal-section"},"\n          ",["H4",{},"1. Responsable del Tratamiento"],"\n          ",["P",{},"El responsable del tratamiento de tus datos personales es \"Universidad Tecnológica de Santa Catarina\" (en adelante, \"la Institución\"), con correo de contacto: ",["A",{"href":"mailto:privacy@utsc.edu.mx"},"privacy@utsc.edu.mx"]],"\n        "],"\n        ",["SECTION",{"class":"legal-section"},"\n          ",["H4",{},"2. Datos que Recopilamos"],"\n          ",["P",{},"Recopilamos los siguientes datos cuando te registras y usas la plataforma:"],"\n          ",["UL",{},"\n            ",["LI",{},["STRONG",{},"Datos de identidad:"]," Nombre, correo electrónico."],"\n            ",["LI",{},["STRONG",{},"Datos de autenticación:"]," Contraseña hasheada (nunca almacenamos la contraseña en texto plano)."],"\n            ",["LI",{},["STRONG",{},"Datos de actividad:"]," Rutinas creadas, entrenamientos completados, progreso, medallas obtenidas."],"\n            ",["LI",{},["STRONG",{},"Datos técnicos:"]," Dirección IP, tipo de navegador, sistema operativo, páginas visitadas (para analítica y seguridad)."],"\n          "],"\n        "],"\n        ",["SECTION",{"class":"legal-section"},"\n          ",["H4",{},"3. Finalidad del Tratamiento"],"\n          ",["P",{},"Utilizamos tus datos para:"],"\n          ",["UL",{},"\n            ",["LI",{},"Crear y gestionar tu cuenta de usuario."],"\n            ",["LI",{},"Proporcionar las funcionalidades de la plataforma (rutinas, progreso, chatbot, mapa)."],"\n            ",["LI",{},"Personalizar tu experiencia y recomendaciones."],"\n            ",["LI",{},"Enviar notificaciones relacionadas con tu cuenta (nunca spam)."],"\n            ",["LI",{},"Mejorar la plataforma mediante analítica anonimizada."],"\n            ",["LI",{},"Cumplir obligaciones legales."],"\n          "],"\n        "],"\n        ",["SECTION",{"class":"legal-section"},"\n          ",["H4",{},"4. Base Legal"],"\n          ",["P",{},"El tratamiento se basa en:"],"\n          ",["UL",{},"\n            ",["LI",{},"Ejecución de un contrato (términos de servicio) para la prestación del servicio."],"\n            ",["LI",{},"Consentimiento del usuario para comunicaciones opcionales y analítica."],"\n            ",["LI",{},"Interés legítimo para seguridad y prevención de fraude."],"\n            ",["LI",{},"Obligación legal para cumplimiento normativo."],"\n          "],"\n        "],"\n        ",["SECTION",{"class":"legal-section"},"\n          ",["H4",{},"5. Compartición de Datos"],"\n          ",["P",{},["STRONG",{},"No vendemos tus datos a terceros."]," Solo compartimos datos con:"],"\n          ",["UL",{},"\n            ",["LI",{},"Proveedores de servicios esenciales (hosting, base de datos, email) bajo contratos de procesamiento de datos."],"\n            ",["LI",{},"Autoridades competentes cuando lo exija la ley."],"\n          "],"\n        "],"\n        ",["SECTION",{"class":"legal-section"},"\n          ",["H4",{},"6. Transferencias Internacionales"],"\n                  ",["P",{},"Los datos se almacenan en servidores ubicados en México. No realizamos transferencias internacionales sin las garantías adecuadas conforme a la LFPDPPP."],"\n        "],"\n        ",["SECTION",{"class":"legal-section"},"\n          ",["H4",{},"7. Conservación de Datos"],"\n          ",["P",{},"Conservamos tus datos mientras tu cuenta esté activa. Tras la eliminación de la cuenta, los datos se anonimizan o eliminan en un plazo máximo de 30 días, salvo obligación legal de conservación."],"\n        "],"\n        ",["SECTION",{"class":"legal-section"},"\n                  ",["H4",{},"8. Tus Derechos (LFPDPPP)"],"\n                  ",["P",{},"Tienes derecho a ejercer tus derechos ARCO (Acceso, Rectificación, Cancelación y Oposición) conforme a la Ley Federal de Protección de Datos Personales en Posesión de los Particulares:"],"\n          ",["UL",{},"\n            ",["LI",{},["STRONG",{},"Acceso:"]," Obtener confirmación de si tratamos tus datos y acceder a ellos."],"\n            ",["LI",{},["STRONG",{},"Rectificación:"]," Corregir datos inexactos o incompletos."],"\n                    ",["LI",{},["STRONG",{},"Cancelación:"]," Solicitar la eliminación de tus datos cuando no sean necesarios."],"\n                    ",["LI",{},["STRONG",{},"Oposición:"]," Oponerte al tratamiento de tus datos para fines específicos."],"\n                    ",["LI",{},["STRONG",{},"Revocar consentimiento:"]," En cualquier momento, sin afectar la licitud del tratamiento previo."],"\n          "],"\n          ",["P",{},"Para ejercer tus derechos, envía un email a ",["A",{"href":"mailto:privacy@utsc.edu.mx"},"privacy@utsc.edu.mx"]," con el asunto \"Derechos ARCO\"."],"\n        "],"\n        ",["SECTION",{"class":"legal-section"},"\n          ",["H4",{},"9. Seguridad"],"\n          ",["P",{},"Implementamos medidas técnicas y organizativas apropiadas: cifrado TLS en tránsito, hashing de contraseñas con bcrypt, JWT para autenticación, validación de entrada, y principio de menor privilegio en base de datos."],"\n        "],"\n        ",["SECTION",{"class":"legal-section"},"\n          ",["H4",{},"10. Cookies y Tecnologías Similares"],"\n          ",["P",{},"Utilizamos cookies esenciales para el funcionamiento (sesión, preferencias de accesibilidad) y cookies analíticas opcionales (con tu consentimiento). Consulta nuestra ",["A",{"href":"#","onclick":""},"Política de Cookies"]," para más detalles."],"\n        "],"\n        ",["SECTION",{"class":"legal-section"},"\n          ",["H4",{},"11. Menores de Edad"],"\n          ",["P",{},"La plataforma no está dirigida a menores de 13 años. No recopilamos intencionadamente datos de menores. Si detectamos datos de un menor, los eliminaremos inmediatamente."],"\n        "],"\n        ",["SECTION",{"class":"legal-section"},"\n          ",["H4",{},"12. Cambios en esta Política"],"\n          ",["P",{},"Podemos actualizar esta política. Te notificaremos de cambios materiales mediante email o aviso en la plataforma. La versión actualizada entrará en vigor tras su publicación."],"\n        "],"\n        ",["SECTION",{"class":"legal-section"},"\n          ",["H4",{},"13. Contacto"],"\n          ",["P",{},"Delegado de Protección de Datos: ",["A",{"href":"mailto:dpo@utsc.edu.mx"},"dpo@utsc.edu.mx"]],"\n        "],"\n                ",["P",{"class":"legal-last-updated"},"Última actualización: 17 de noviembre de 2026"],"\n      "],"\n    "],"\n  "],"\n\n  ",["DIV",{"id":"cookies-modal","class":"legal-modal-overlay hidden","aria-labelledby":"cookies-modal-title","role":"dialog","aria-modal":"true"},"\n    ",["DIV",{"class":"legal-modal-sheet"},"\n      ",["HEADER",{"class":"legal-modal-header"},"\n        ",["H3",{"id":"cookies-modal-title"},"Política de Cookies"],"\n        ",["BUTTON",{"class":"legal-modal-close","onclick":"","aria-label":"Cerrar"},"\n          ",["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","data-lucide":"x","aria-hidden":"true","class":"lucide lucide-x"},["path",{"d":"M18 6 6 18"}],["path",{"d":"m6 6 12 12"}]],"\n        "],"\n      "],"\n      ",["DIV",{"class":"legal-modal-body"},"\n        ",["SECTION",{"class":"legal-section"},"\n          ",["H4",{},"¿Qué son las cookies?"],"\n          ",["P",{},"Las cookies son pequeños archivos de texto que se almacenan en tu dispositivo cuando visitas un sitio web. Permiten recordar tus preferencias y mejorar tu experiencia."],"\n        "],"\n        ",["SECTION",{"class":"legal-section"},"\n          ",["H4",{},"Tipos de cookies que utilizamos"],"\n          ",["TABLE",{"class":"cookies-table"},"\n            ",["THEAD",{},"\n              ",["TR",{},"\n                ",["TH",{},"Tipo"],"\n                ",["TH",{},"Nombre"],"\n                ",["TH",{},"Finalidad"],"\n                ",["TH",{},"Duración"],"\n              "],"\n            "],"\n 