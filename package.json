{
  "name": "entrenatu-ser",
  "version": "1.0.0",
  "description": "Plataforma de fitness personal - Entrena Tu Ser",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:frontend\"",
    "dev:api": "cd api && dotnet run",
    "dev:frontend": "python -m http.server 5500",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:a11y": "playwright test tests/accessibility.spec.js",
    "lint": "eslint js/",
    "lint:fix": "eslint js/ --fix",
    "format": "prettier --write \"**/*.{js,html,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,html,css,json,md}\"",
    "docs": "jsdoc -c jsdoc.json",
    "bundle:analyze": "vite build --mode analyze",
    "lhci": "lhci autorun",
    "lhci:desktop": "lhci autorun --config=lighthouserc.cjs",
    "lhci:mobile": "lhci autorun --config=lighthouserc.mobile.cjs",
    "pwa:build": "vite build && workbox generateSW workbox-config.cjs",
    "pwa:dev": "vite build --mode development && workbox generateSW workbox-config.cjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.45.0",
    "@types/node": "^20.14.0",
    "axe-core": "^4.14.1",
    "concurrently": "^8.2.0",
    "docdash": "^2.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jsdoc": "^48.0.0",
    "eslint-plugin-prettier": "^5.1.0",
    "globals": "^15.0.0",
    "jsdoc": "^4.0.0",
    "prettier": "^3.3.0",
    "rollup-plugin-visualizer": "^7.3.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.8",
    "workbox-cli": "^7.4.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chart.js": "^4.6.2",
    "ffmpeg-static": "^5.3.0",
    "leaflet": "^1.9.4",
    "lucide": "^1.79.0",
    "three": "^0.187.0"
  }
}